# Compose project name
COMPOSE_PROJECT_NAME=tourism-agency

# Local binding. Keep 127.0.0.1 when Cloudflare Tunnel is the public entrypoint.
BIND_IP=127.0.0.1
EDGE_PORT=8081

# Data root (unused by this project, kept for consistency with the other projects)
DATA_ROOT=/opt/docker-projects-data/tourism-agency
